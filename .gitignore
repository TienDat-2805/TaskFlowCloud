# Publish only application sources and repository tooling.
/*
!/.gitignore
!/.gitattributes
!/.editorconfig
!/.dockerignore
!/.prettierignore
!/.prettierrc.json
!/.env.example
!/.github/
!/README.md
!/package.json
!/package-lock.json
!/eslint.config.js
!/compose.dev.yml
!/compose.prod.yml
!/backend/
!/frontend/
!/infra/
!/docs/

/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/ci.yml

/backend/*
!/backend/package.json
!/backend/Dockerfile
!/backend/tsconfig.json
!/backend/tsconfig.build.json
!/backend/vitest.config.ts
!/backend/src/
!/backend/scripts/

/frontend/*
!/frontend/package.json
!/frontend/Dockerfile
!/frontend/tsconfig.json
!/frontend/vite.config.ts
!/frontend/vitest.config.ts
!/frontend/playwright.config.ts
!/frontend/index.html
!/frontend/nginx.conf
!/frontend/src/
!/frontend/public/

/infra/*
!/infra/caddy/
/infra/caddy/*
!/infra/caddy/Caddyfile

# Documentation is limited to versioned release notes.
/docs/*
!/docs/releases/
/docs/releases/*
!/docs/releases/v[0-9]*.md

node_modules/
dist/
coverage/
.env
.env.*
!.env.example
*.log
.cache/
tmp/
playwright-report/
test-results/
*.pem
*.key
*.archive
*.bak
*.backup
.DS_Store
.idea/
.vscode/
