NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/taskflow_dev
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
COOKIE_SECURE=false
CLIENT_ORIGIN=http://localhost:5173
TRUST_PROXY=0
LOG_LEVEL=info
# Backend workflow expansion. Keep off until migration and a compatible client are ready.
TASKFLOW_V02_ENABLED=false
REQUIRE_TASK_REVISION=false
# Optional demo account; required only by npm run seed.
SEED_EMAIL=demo@example.com
SEED_PASSWORD=replace-with-your-demo-password

# Optional: process-local DNS workaround if Node reports querySrv ECONNREFUSED.
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
